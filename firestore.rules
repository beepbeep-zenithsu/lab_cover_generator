rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone may READ the shared student list / course config.
    // Only the verified admin email may WRITE it.
    match /labcover/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "rafiulislam@iut-dhaka.edu"
                   && request.auth.token.email_verified == true;
    }
  }
}
